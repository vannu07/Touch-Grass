# Optional. If none of these are set, Last Light still issues tickets
# using the offline field recipes and TabPFN on CPU.

# Local open-weight Gemma via Ollama (best for the challenge story)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Hosted Gemma if you do not want to run Ollama
# GROQ_API_KEY=
# GROQ_MODEL=gemma2-9b-it
# GOOGLE_API_KEY=
# GEMMA_MODEL=gemma-3-4b-it

# Optional: read the ticket aloud, then pocket the phone
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2
